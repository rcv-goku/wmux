{
  "//": "Reply shapes of the legacy wmux JSON command 'tab-list' (ADR-3.7), keyed by case; see README.md.",
  "ok": {
    "<strict>": true,
    "id": "<int>",
    "ok": true,
    "data": [
      "<each>",
      {
        "<strict>": true,
        "index": "<int>",
        "title": "<string>",
        "active": "<bool>"
      }
    ]
  },
  "unknown_pane": {
    "<strict>": true,
    "id": "<int>",
    "ok": false,
    "error": "UnknownPane"
  }
}
