 }
+
+// SPIKE S3: replayed history (scrolled into scrollback with rows x CRLF)
+// versus a resize that lands before ConPTY's first frame
+// (ESC[2J ESC[m ESC[H). Returns how many of the 30 history lines survive.
+const S3Placement = enum { bottom, home };
+const S3Resize = enum { none, grow, short, narrow, narrow_grow };
+fn s3Survivors(alloc: Allocator, placement: S3Placement, resize_kind: S3Resize) !usize {
+    var t = try init(alloc, .{ .cols = 20, .rows = 6 });
+    defer t.deinit(alloc);
+    for (0..30) |i| {
+        var buf: [32]u8 = undefined;
+        try t.printString(try std.fmt.bufPrint(&buf, "H{d:0>2} abcdefghijk", .{i}));
+        if (i != 29) {
+            t.carriageReturn();
+            try t.linefeed();
+        }
+    }
+    for (0..t.rows) |_| {
+        t.carriageReturn();
+        try t.linefeed();
+    }
+    if (placement == .home) t.setCursorPos(1, 1);
+    switch (resize_kind) {
+        .none => {},
+        .grow => try t.resize(alloc, 20, 10),
+        .short => try t.resize(alloc, 20, 4),
+        .narrow => try t.resize(alloc, 10, 6),
+        .narrow_grow => try t.resize(alloc, 10, 9),
+    }
+    // ConPTY's first frame.
+    t.eraseDisplay(.complete, false);
+    t.setCursorPos(1, 1);
+    try t.printString("PROMPT>");
+    const s = try t.screens.active.dumpStringAllocUnwrapped(alloc, .{ .screen = .{} });
+    defer alloc.free(s);
+    var count: usize = 0;
+    for (0..30) |i| {
+        var buf: [8]u8 = undefined;
+        if (std.mem.indexOf(u8, s, try std.fmt.bufPrint(&buf, "H{d:0>2} ", .{i})) != null) count += 1;
+    }
+    return count;
+}
+
+test "S3 spike: replay placement vs early resize" {
+    const alloc = testing.allocator;
+    inline for (.{ S3Placement.bottom, S3Placement.home }) |pl| {
+        inline for (.{ S3Resize.none, S3Resize.grow, S3Resize.short, S3Resize.narrow, S3Resize.narrow_grow }) |rk| {
+            const n = try s3Survivors(alloc, pl, rk);
+            std.debug.print("S3 placement={s} resize={s} survivors={d}/30\n", .{ @tagName(pl), @tagName(rk), n });
+            if (pl == .home) try testing.expectEqual(@as(usize, 30), n);
+        }
+    }
+}
