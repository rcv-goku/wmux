diff --git a/src/apprt/win32/hidden_mode.zig b/src/apprt/win32/hidden_mode.zig
new file mode 100644
index 0000000..82405a2
--- /dev/null
+++ b/src/apprt/win32/hidden_mode.zig
@@ -0,0 +1,178 @@
+//! S2 spike (W0-D-S2) prototype of the WMUX_TEST_HIDDEN window policy
+//! (ARCHITECTURE ADR-12.3). Throwaway: kept only as a patch under
+//! docs/arch/spikes/proto/S2/. The real implementation belongs to
+//! app/runtime_env.zig + app/foreground.zig (W0-A/W1).
+//!
+//! WMUX_TEST_HIDDEN=1 makes every top-level window a WS_EX_TOOLWINDOW |
+//! WS_EX_NOACTIVATE window with a fixed 1600x1000 client area that is only
+//! ever shown with SW_SHOWNOACTIVATE, and suppresses every activation path
+//! (SetForegroundWindow, activating ShowWindow/SetWindowPos, SetFocus calls
+//! that would activate the top-level window).
+//!
+//! Spike-only knobs:
+//!   WMUX_TEST_HIDDEN_PLACEMENT=offscreen (default; ADR text: -32000,-32000)
+//!                             | cloak (primary work-area origin + DWMWA_CLOAK)
+//!   WMUX_TEST_HIDDEN_FOCUS=gate (default; SetFocus only when the top-level
+//!                         window is already the thread's active window)
+//!                         | keep (call SetFocus as usual)
+const std = @import("std");
+const w32 = @import("win32.zig");
+
+const log = std.log.scoped(.hidden_mode);
+
+pub const Placement = enum { offscreen, cloak };
+pub const FocusPolicy = enum { gate, keep };
+
+pub const client_width: i32 = 1600;
+pub const client_height: i32 = 1000;
+pub const offscreen_pos: i32 = -32000;
+
+const DWMWA_CLOAK: u32 = 13;
+const DWMWA_CLOAKED: u32 = 14;
+const GA_ROOT: u32 = 2;
+
+extern "user32" fn GetActiveWindow() callconv(.winapi) ?w32.HWND;
+extern "user32" fn GetAncestor(hwnd: w32.HWND, flags: u32) callconv(.winapi) ?w32.HWND;
+extern "dwmapi" fn DwmGetWindowAttribute(hwnd: w32.HWND, attr: u32, pv: *anyopaque, cb: u32) callconv(.winapi) i32;
+
+var enabled_flag: bool = false;
+var placement: Placement = .offscreen;
+var focus_policy: FocusPolicy = .gate;
+
+/// Counters for the spike report (UI thread only).
+pub var rewritten_show: u32 = 0;
+pub var rewritten_swp: u32 = 0;
+pub var suppressed_foreground: u32 = 0;
+pub var gated_setfocus: u32 = 0;
+
+/// Read the environment once, on the UI thread, before any window exists.
+pub fn init() void {
+    var buf: [64]u8 = undefined;
+    var fba = std.heap.FixedBufferAllocator.init(&buf);
+    const alloc = fba.allocator();
+    const v = std.process.getEnvVarOwned(alloc, "WMUX_TEST_HIDDEN") catch return;
+    enabled_flag = std.mem.eql(u8, v, "1");
+    if (!enabled_flag) return;
+    fba.reset();
+    if (std.process.getEnvVarOwned(alloc, "WMUX_TEST_HIDDEN_PLACEMENT")) |p| {
+        if (std.mem.eql(u8, p, "cloak")) placement = .cloak;
+    } else |_| {}
+    fba.reset();
+    if (std.process.getEnvVarOwned(alloc, "WMUX_TEST_HIDDEN_FOCUS")) |f| {
+        if (std.mem.eql(u8, f, "keep")) focus_policy = .keep;
+    } else |_| {}
+    log.info("hidden mode on placement={s} focus={s}", .{ @tagName(placement), @tagName(focus_policy) });
+}
+
+pub fn enabled() bool {
+    return enabled_flag;
+}
+
+pub fn exStyle(base: u32) u32 {
+    return base | w32.WS_EX_TOOLWINDOW | w32.WS_EX_NOACTIVATE;
+}
+
+pub const Rect = struct { x: i32, y: i32, w: i32, h: i32 };
+
+/// Window rect for a fixed 1600x1000 client area at the hidden position.
+pub fn initialRect(style: u32, ex_style: u32) Rect {
+    var r: w32.RECT = .{ .left = 0, .top = 0, .right = client_width, .bottom = client_height };
+    _ = w32.AdjustWindowRectEx(&r, style, 0, ex_style);
+    const w = r.right - r.left;
+    const h = r.bottom - r.top;
+    return switch (placement) {
+        .offscreen => .{ .x = offscreen_pos, .y = offscreen_pos, .w = w, .h = h },
+        .cloak => blk: {
+            // GL presents are clipped to window ∩ monitors, so the cloaked
+            // window must sit fully inside a monitor: use the primary
+            // monitor's work-area origin.
+            var x: i32 = 0;
+            var y: i32 = 0;
+            if (w32.MonitorFromPoint(.{ .x = 0, .y = 0 }, w32.MONITOR_DEFAULTTOPRIMARY)) |mon| {
+                var mi: w32.MONITORINFO = undefined;
+                mi.cbSize = @sizeOf(w32.MONITORINFO);
+                if (w32.GetMonitorInfoW(mon, &mi) != 0) {
+                    x = mi.rcWork.left;
+                    y = mi.rcWork.top;
+                }
+            }
+            break :blk .{ .x = x, .y = y, .w = w, .h = h };
+        },
+    };
+}
+
+fn isTopLevelCreate(style: u32, parent: ?w32.HWND) bool {
+    return style & w32.WS_CHILD == 0 and parent != w32.HWND_MESSAGE;
+}
+
+/// CreateWindowExW filter: every top-level window (the main window and all
+/// owned popups) is a tool window that cannot be activated.
+pub fn filterCreateExStyle(ex: u32, style: u32, parent: ?w32.HWND) u32 {
+    if (!enabled_flag or !isTopLevelCreate(style, parent)) return ex;
+    return exStyle(ex);
+}
+
+/// Called right after CreateWindowExW for every window. In cloak placement,
+/// cloak each top-level window before it can be shown; if cloaking fails,
+/// move it off-screen so a failure can never put a visible window on the
+/// user's screen.
+pub fn afterCreate(hwnd: w32.HWND, style: u32, parent: ?w32.HWND) void {
+    if (!enabled_flag or placement != .cloak or !isTopLevelCreate(style, parent)) return;
+    const on: u32 = 1;
+    const hr = w32.DwmSetWindowAttribute(hwnd, DWMWA_CLOAK, &on, @sizeOf(u32));
+    var state: u32 = 0;
+    _ = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &state, @sizeOf(u32));
+    if (hr != 0 or state == 0) {
+        log.warn("DWMWA_CLOAK failed hr=0x{x:0>8} state={d}; falling back to off-screen", .{ @as(u32, @bitCast(hr)), state });
+        _ = w32.raw.SetWindowPos(hwnd, null, offscreen_pos, offscreen_pos, 0, 0, w32.SWP_NOSIZE | w32.SWP_NOZORDER | w32.SWP_NOACTIVATE);
+        return;
+    }
+    log.info("cloaked top-level hwnd=0x{x}", .{@intFromPtr(hwnd)});
+}
+
+fn isTopLevel(hwnd: w32.HWND) bool {
+    return (w32.GetWindowLongW(hwnd, w32.GWL_STYLE) & w32.WS_CHILD) == 0;
+}
+
+/// ShowWindow filter: top-level windows are only ever shown with
+/// SW_SHOWNOACTIVATE (SW_HIDE / SW_SHOWNA pass through).
+pub fn filterShow(hwnd: w32.HWND, cmd: i32) i32 {
+    if (!enabled_flag or !isTopLevel(hwnd)) return cmd;
+    return switch (cmd) {
+        0, 4, 8 => cmd, // SW_HIDE, SW_SHOWNOACTIVATE, SW_SHOWNA
+        else => blk: {
+            rewritten_show += 1;
+            log.info("ShowWindow hwnd=0x{x} cmd={d} -> SW_SHOWNOACTIVATE", .{ @intFromPtr(hwnd), cmd });
+            break :blk w32.SW_SHOWNOACTIVATE;
+        },
+    };
+}
+
+/// SetWindowPos filter: never activate a top-level window.
+pub fn filterSwpFlags(hwnd: w32.HWND, flags: u32) u32 {
+    if (!enabled_flag or !isTopLevel(hwnd) or flags & w32.SWP_NOACTIVATE != 0) return flags;
+    rewritten_swp += 1;
+    log.info("SetWindowPos hwnd=0x{x} flags=0x{x} += SWP_NOACTIVATE", .{ @intFromPtr(hwnd), flags });
+    return flags | w32.SWP_NOACTIVATE;
+}
+
+/// SetForegroundWindow / raise paths: never in hidden mode.
+pub fn allowForeground(what: []const u8) bool {
+    if (!enabled_flag) return true;
+    suppressed_foreground += 1;
+    log.info("suppressed foreground request: {s}", .{what});
+    return false;
+}
+
+/// SetFocus activates the target's top-level window when it is not the
+/// thread's active window. With the gate policy, only call SetFocus when
+/// that activation cannot happen (top-level already active).
+pub fn allowSetFocus(hwnd: ?w32.HWND) bool {
+    if (!enabled_flag or focus_policy == .keep) return true;
+    const h = hwnd orelse return true;
+    const root = GetAncestor(h, GA_ROOT) orelse return true;
+    if (GetActiveWindow() == root) return true;
+    gated_setfocus += 1;
+    log.info("gated SetFocus hwnd=0x{x} (top-level not active)", .{@intFromPtr(h)});
+    return false;
+}
